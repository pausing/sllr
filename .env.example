# Environment variables for SLLR

# Data directory (mount a volume to this path in production)
SLLR_DATA_DIR=data

# Frontend static files directory
STATIC_DIR=frontend/dist

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Root path for mounting under a subpath (e.g., /sllr)
# SLLR_ROOT_PATH=/sllr

# Server port
PORT=8000
