# Environment variables for SLLR

# Live SQLite directory (lessons.db). Default data/ in the image.
# Optional in Dokploy: SLLR_DATA_DIR=/data after the volume can hold a sqlite file
# (empty dir is OK). Not required to contain CSVs.
SLLR_DATA_DIR=data

# Frontend static files directory
STATIC_DIR=frontend/dist

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Root path for mounting under a subpath (e.g., /sllr)
# SLLR_ROOT_PATH=/sllr

# Server port
PORT=8000
